                   [Paragraph("Complete Scholarly Analysis, Direct Quranic Counts, Canonical Citations, and Jurisprudential Reconciliations", subtitle_style)]]
    
    header_table = Table(header_data, colWidths=[510])
    header_table.setStyle(TableStyle([
        ('BACKGROUND', (0,0), (-1,-1), NAVY),
        ('BOX', (0,0), (-1,-1), 2, GOLD),
        ('PADDING', (0,0), (-1,-1), 20),
        ('ALIGN', (0,0), (-1,-1), 'CENTER'),
        ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),
    ]))
    story.append(header_table)
    
    story.append(Spacer(1, 150))
    
    meta_text = """
    <b>Prepared for:</b> Nisaar Ally<br/>
    <b>Document Framework:</b> Classical Illumination & Manuscript Typology Specification<br/>
    <b>Primary Reference Sources:</b> Sahih al-Bukhari & Sahih Muslim<br/>
    <b>Scope:</b> 11 Targeted Names, Full Arabic Text, Phonetic Transliteration & Fiqh Analysis<br/>
    <b>Date of Issue:</b> October 2026
    """
    story.append(Paragraph(meta_text, ParagraphStyle('Meta', parent=body_style, alignment=TA_CENTER, leading=16)))
    
    story.append(PageBreak())
    
    # --- DOCUMENT BODY ---
    story.append(Paragraph("SECTION 1: EXECUTIVE DESIGN SPECIFICATION", h1_style))
    story.append(HRFlowable(width="100%", thickness=1, color=GOLD, spaceAfter=10))
    story.append(Paragraph(
        "This document integrates traditional Islamic manuscript aesthetics with systematic textual data analysis. "
        "The decorative frame utilizes geometric boundaries (<i>jidar</i>) in Deep Navy and Antique Gold to delineate structural boundaries without distracting from the sacred text.",
        body_style
    ))
    
    story.append(Spacer(1, 15))
    story.append(Paragraph("SECTION 2: CONSOLIDATED ELEVEN-NAME MASTER MATRIX", h1_style))
    story.append(HRFlowable(width="100%", thickness=1, color=GOLD, spaceAfter=10))
    
    # Matrix Data
    table_data = [
        ["Name", "Quran Count", "Hadith Frequency", "Primary Sahih Citations"],
        ["Zainab (زَيْنَب)", "0 Explicit (1 Indirect)", "Hundreds", "Bukhari 4787 / Muslim 1428"],
        ["Zayd (زَيْد)", "1 Explicit (33:37)", "Thousands", "Bukhari 4261 / Muslim 2425"],
        ["Suhail (سُهَيْل)", "0 Explicit", "Frequent", "Bukhari 2731 / Muslim 1783"],
        ["Sabeeha (سُبَيْعَة)", "0 Explicit", "Pivotal Fiqh", "Bukhari 5318 / Muslim 1484"],
        ["Fathima (فَاطِمَة)", "0 Explicit (3 Indirect)", "Hundreds", "Bukhari 3714 / Muslim 2449"],
        ["Ismail (إِسْمَاعِيل)", "12 Explicit", "Thousands", "Bukhari 3364 / Muslim 2276"],
        ["Khadijah (خَدِيجَة)", "0 Explicit (1 Indirect)", "Dozens of Ch.", "Bukhari 3 / Muslim 2432"],
        ["Ahmadullah (أَحْمَد)", "0 Compound (1 Ahmad)", "0 Compound", "Bukhari 3532 / Muslim 2354"],
        ["Nisaar (نِسَار)", "0 Personal", "0 Personal", "Book Titles (Kitab an-Nisa)"],
        ["Mohammed (مُحَمَّد)", "4 Explicit (3:144...)", "Ubiquitous", "Bukhari 3532 / Muslim 2354"],
        ["Imran (عِمْرَان)", "3 Explicit (3:33...)", "Hundreds", "Bukhari 789 / Muslim 2259"]
    ]
    
    t = Table(table_data, colWidths=[120, 110, 120, 160])
    t.setStyle(TableStyle([
        ('BACKGROUND', (0,0), (-1,0), NAVY),
        ('TEXTCOLOR', (0,0), (-1,0), GOLD),
        ('FONTNAME', (0,0), (-1,0), 'Helvetica-Bold'),
        ('FONTSIZE', (0,0), (-1,0), 9),
        ('BOTTOMPADDING', (0,0), (-1,0), 6),
        ('BACKGROUND', (0,1), (-1,-1), CREAM),
        ('GRID', (0,0), (-1,-1), 0.5, GOLD),
        ('FONTNAME', (0,1), (-1,-1), 'Helvetica'),
        ('FONTSIZE', (0,1), (-1,-1), 8.5),
        ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),
    ]))
    story.append(t)
    
    doc.build(story, canvasmaker=IlluminatedCanvas)
    print(f"PDF Successfully Generated: {filename}")

if __name__ == "__main__":
    build_pdf()
