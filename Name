import os
from reportlab.lib.pagesizes import letter
from reportlab.lib import colors
from reportlab.platypus import (
    SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle, PageBreak, HRFlowable
)
from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
from reportlab.lib.enums import TA_CENTER, TA_JUSTIFY, TA_LEFT, TA_RIGHT
from reportlab.pdfgen import canvas

# Define Palette based on Holy Quran Design Specification
NAVY = colors.HexColor('#0F1B29')      # Frame / Primary Structural Boundary
GOLD = colors.HexColor('#D4AF37')      # Ornamental Border / Celestial Accent
CREAM = colors.HexColor('#FDFBF7')     # Parchment Vellum Background
RED = colors.HexColor('#B22222')       # Diacritical / Legal Focus Highlight
GREEN = colors.HexColor('#006633')     # Sub-section Accent Medallion
BLACK = colors.HexColor('#111111')     # Body Text

class IlluminatedCanvas(canvas.Canvas):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.pages = []

    def showPage(self):
        self.pages.append(dict(self.__dict__))
        self._startPage()

    def save(self):
        num_pages = len(self.pages)
        for page in self.pages:
            self.__dict__.update(page)
            self.draw_background_and_borders(num_pages)
            super().showPage()
        super().save()

    def draw_background_and_borders(self, total_pages):
        self.saveState()
        width, height = letter
        
        # 1. Parchment Background Fill
        self.setFillColor(CREAM)
        self.rect(0, 0, width, height, fill=1, stroke=0)
        
        # 2. Outer Structural Border (Jidar) - Double Golden & Navy Lines
        self.setStrokeColor(NAVY)
        self.setLineWidth(3)
        self.rect(20, 20, width - 40, height - 40)
        
        self.setStrokeColor(GOLD)
        self.setLineWidth(1)
        self.rect(25, 25, width - 50, height - 50)
        
        # 3. Corner Accent Medallions
        corner_size = 15
        for x, y in [(20, 20), (width - 20 - corner_size, 20), 
                    (20, height - 20 - corner_size), (width - 20 - corner_size, height - 20 - corner_size)]:
            self.setFillColor(GOLD)
            self.rect(x, y, corner_size, corner_size, fill=1, stroke=0)
        
        # 4. Header & Footer Running Details (Pages > 1)
        if self._pageNumber > 1:
            self.setFont("Helvetica-Bold", 8)
            self.setFillColor(NAVY)
            self.drawString(35, height - 35, "HOLY QURAN & HADITH SCHOLARLY ARCHIVE")
            self.drawRightString(width - 35, height - 35, "MANUSCRIPT COMPILATION")
            
            self.setStrokeColor(GOLD)
            self.setLineWidth(0.5)
            self.line(35, height - 40, width - 35, height - 40)
            self.line(35, 40, width - 35, 40)
            
            self.setFont("Helvetica", 8)
            self.drawString(35, 28, "Confidential & Proprietary - Academic Record")
            self.drawRightString(width - 35, 28, f"Page {self._pageNumber} of {total_pages}")
            
        self.restoreState()

def build_pdf(filename="Holy_Quran_and_Hadith_Scholarly_Compilation.pdf"):
    doc = SimpleDocTemplate(
        filename,
        pagesize=letter,
        leftMargin=40,
        rightMargin=40,
        topMargin=50,
        bottomMargin=50
    )
    
    styles = getSampleStyleSheet()
    
    # Custom Typography Styles
    title_style = ParagraphStyle(
        'CoverTitle',
        parent=styles['Normal'],
        fontName='Helvetica-Bold',
        fontSize=24,
        leading=28,
        textColor=GOLD,
        alignment=TA_CENTER,
        spaceAfter=15
    )
    
    subtitle_style = ParagraphStyle(
        'CoverSubtitle',
        parent=styles['Normal'],
        fontName='Helvetica',
        fontSize=12,
        leading=16,
